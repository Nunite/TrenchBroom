QTableView {
  border: none;
}

QListWidget {
  border: none;
}

QListWidget#controlListBox_listWidget {
  border: none;
}

QCheckBox#entityDefinition_checkboxWidget {
  margin-left: 11px;
}

QToolButton#backgroundChecked {
  border: none;
}

QToolButton#backgroundChecked::checked {
  background-color: rgba(0, 0, 0, 50);
}

QToolButton#toolButton_withBorder {
  border: 1 solid rgba(0, 0, 0, 50);
  border-radius: 3;
}

QToolButton#toolButton_withBorder::checked {
  background-color: rgba(0, 0, 0, 25);
}

QToolButton#toolButton_borderless {
  border: none;
}

QToolButton#toolButton_borderless::menu-indicator {
 image: none;
}

QScrollArea#outlinerPropertyScrollArea {
  background: transparent;
}

QWidget#outlinerPropertyCard {
  background-color: rgba(255, 255, 255, 12);
  border: 1 solid rgba(0, 0, 0, 80);
  border-radius: 8;
}

QWidget#outlinerPropertyRow {
  background-color: rgba(0, 0, 0, 28);
  border: 1 solid rgba(0, 0, 0, 70);
  border-radius: 8;
}

QWidget#outlinerPropertyRow:hover {
  background-color: rgba(255, 255, 255, 14);
}

QWidget#outlinerPropertyRow[inactive="true"] {
  background-color: rgba(0, 0, 0, 18);
  border: 1 solid rgba(0, 0, 0, 55);
}

QWidget#outlinerPropertyRow[inactive="true"]:hover {
  background-color: rgba(255, 255, 255, 10);
}

QLabel#outlinerPropertyKey {
  color: rgba(255, 255, 255, 190);
}

QLabel#outlinerPropertyKey[inactive="true"] {
  color: rgba(255, 255, 255, 130);
  font-style: italic;
}

QLineEdit#outlinerPropertyValue,
QComboBox#outlinerPropertyValue,
QLineEdit#outlinerPropertyAddKey,
QLineEdit#outlinerPropertyAddValue {
  background-color: rgba(0, 0, 0, 32);
  border: 1 solid rgba(0, 0, 0, 75);
  border-radius: 8;
  padding: 3px 6px;
  color: rgba(255, 255, 255, 230);
  selection-background-color: rgba(255, 255, 255, 35);
  selection-color: rgba(255, 255, 255, 255);
}

QLineEdit#outlinerPropertyValue:focus,
QComboBox#outlinerPropertyValue:focus,
QLineEdit#outlinerPropertyAddKey:focus,
QLineEdit#outlinerPropertyAddValue:focus {
  border: 1 solid rgba(255, 255, 255, 70);
  background-color: rgba(255, 255, 255, 10);
  color: rgba(255, 255, 255, 255);
}

QLineEdit#outlinerPropertyValue:disabled,
QComboBox#outlinerPropertyValue:disabled,
QLineEdit#outlinerPropertyAddKey:disabled,
QLineEdit#outlinerPropertyAddValue:disabled {
  color: rgba(255, 255, 255, 140);
  background-color: rgba(0, 0, 0, 18);
  border: 1 solid rgba(0, 0, 0, 55);
}

QComboBox#outlinerPropertyValue QAbstractItemView {
  background-color: rgba(0, 0, 0, 220);
  color: rgba(255, 255, 255, 230);
  selection-background-color: rgba(255, 255, 255, 35);
  selection-color: rgba(255, 255, 255, 255);
}

QWidget#outlinerPropertyColorButton {
  background: transparent;
}

QWidget#outlinerPropertyColorButton QPushButton {
  background-color: rgba(0, 0, 0, 32);
  border: 1 solid rgba(0, 0, 0, 75);
  border-radius: 8;
  padding: 3px 6px;
  color: rgba(255, 255, 255, 230);
}

QWidget#outlinerPropertyColorButton QPushButton:hover {
  background-color: rgba(255, 255, 255, 10);
}

QWidget#outlinerPropertyColorButton QPushButton:pressed {
  background-color: rgba(255, 255, 255, 14);
}

QWidget#outlinerPropertyColorButton QPushButton:disabled {
  color: rgba(255, 255, 255, 140);
  background-color: rgba(0, 0, 0, 18);
  border: 1 solid rgba(0, 0, 0, 55);
}
