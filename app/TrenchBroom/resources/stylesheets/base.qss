QTableView {
  border: none;
}

QListWidget {
  border: none;
}

QListWidget#controlListBox_listWidget {
  border: none;
}

QCheckBox#entityDefinition_checkboxWidget {
  margin-left: 11px;
}

QToolButton#toolButton_withBorder {
  border: 1 solid rgba(0, 0, 0, 50);
  border-radius: 3;
}

QToolButton#toolButton_withBorder::checked {
  background-color: rgba(0, 0, 0, 25);
}

tb--ui--BitmapButton {
  border: none;
}

tb--ui--BitmapButton::menu-indicator {
 image: none;
}

QScrollArea#outlinerPropertyScrollArea {
  background: transparent;
}

QWidget#outlinerPropertyList {
  background: palette(base);
}

QLabel#outlinerPropertySelectionSummary {
  background: palette(alternate-base);
  border-bottom: 1 solid palette(mid);
  padding: 6px 8px;
  font-weight: bold;
}

QWidget#outlinerPropertyAddBar {
  background: palette(window);
  border-top: 1 solid palette(mid);
}

QWidget#outlinerPropertyRow {
  background: palette(base);
  border-bottom: 1 solid palette(midlight);
}

QWidget#outlinerPropertyRow:hover {
  background: palette(alternate-base);
}

QWidget#outlinerPropertyRow[inactive="true"] {
  background: palette(window);
}

QWidget#outlinerPropertyKey QLabel {
  color: palette(text);
}

QWidget#outlinerPropertyKey[inactive="true"] QLabel {
  color: palette(mid);
  font-style: italic;
}

QWidget#outlinerPropertyColorButton {
  background: transparent;
}
