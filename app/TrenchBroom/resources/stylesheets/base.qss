QMainWindow,
QDialog {
  background: @tb-window-background;
  color: @tb-text;
}

QMenuBar {
  background: @tb-window-background;
  border-bottom: 1px solid @tb-border;
  color: @tb-text;
  padding: 1px 4px;
  spacing: 2px;
}

QMenuBar::item {
  background: transparent;
  border-radius: 3px;
  padding: 4px 7px;
}

QMenuBar::item:selected {
  background: @tb-hover-background;
}

QMenuBar::item:pressed {
  background: @tb-pressed-background;
}

QMenu {
  background: @tb-elevated-background;
  border: 1px solid @tb-strong-border;
  color: @tb-text;
  padding: 4px;
}

QMenu::item {
  border-radius: 3px;
  padding: 4px 28px 4px 8px;
}

QMenu::item:selected {
  background: @tb-selection-background;
  color: @tb-inverse-text;
}

QMenu::item:disabled {
  color: @tb-disabled-text;
}

QMenu::separator {
  background: @tb-border;
  height: 1px;
  margin: 4px 6px;
}

QToolBar {
  background: @tb-panel-background;
  border: none;
  border-bottom: 1px solid @tb-border;
  padding: 2px 4px;
  spacing: 2px;
}

QToolBar QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  padding: 3px;
}

QToolBar QToolButton:hover {
  background: @tb-hover-background;
  border-color: @tb-border;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
  background: @tb-pressed-background;
  border-color: @tb-strong-border;
}

QToolBar QToolButton:disabled {
  color: @tb-disabled-text;
}

QPushButton {
  background: @tb-button-background;
  border: 1px solid @tb-strong-border;
  border-radius: 3px;
  color: @tb-text;
  min-height: 22px;
  padding: 2px 8px;
}

QPushButton:hover {
  background: @tb-hover-background;
}

QPushButton:pressed,
QPushButton:checked {
  background: @tb-pressed-background;
}

QPushButton:focus,
QPushButton:default {
  border-color: @tb-focus-border;
}

QPushButton:disabled {
  color: @tb-disabled-text;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
  background: @tb-input-background;
  border: 1px solid @tb-border;
  border-radius: 3px;
  color: @tb-text;
  min-height: 22px;
  padding: 1px 5px;
  selection-background-color: @tb-selection-background;
  selection-color: @tb-inverse-text;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
  border-color: @tb-strong-border;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
  border-color: @tb-focus-border;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
  background: @tb-window-background;
  color: @tb-disabled-text;
}

QAbstractItemView {
  alternate-background-color: @tb-alternate-background;
  background: @tb-editor-background;
  border: none;
  color: @tb-text;
  outline: none;
  selection-background-color: @tb-selection-background;
  selection-color: @tb-inverse-text;
}

QAbstractItemView::item {
  border: 1px solid transparent;
}

QAbstractItemView::item:hover {
  background: @tb-hover-background;
}

QAbstractItemView::item:selected:!active {
  background: @tb-inactive-selection-background;
}

QTreeView::item,
QListView::item {
  min-height: 22px;
  padding: 1px 4px;
}

QTableView {
  border: none;
  gridline-color: @tb-border;
}

QListWidget {
  border: none;
}

QHeaderView::section {
  background: @tb-panel-background;
  border: none;
  border-bottom: 1px solid @tb-border;
  border-right: 1px solid @tb-border;
  color: @tb-secondary-text;
  min-height: 22px;
  padding: 2px 6px;
}

QTabWidget::pane {
  border: 1px solid @tb-border;
}

QTabBar::tab {
  background: @tb-panel-background;
  border: none;
  border-right: 1px solid @tb-border;
  color: @tb-secondary-text;
  min-height: 26px;
  padding: 0 10px;
}

QTabBar::tab:hover {
  background: @tb-hover-background;
  color: @tb-text;
}

QTabBar::tab:selected {
  background: @tb-editor-background;
  border-top: 1px solid @tb-accent;
  color: @tb-text;
}

QStatusBar {
  background: @tb-panel-background;
  border-top: 1px solid @tb-border;
  color: @tb-secondary-text;
}

QStatusBar::item {
  border: none;
}

QToolTip {
  background: @tb-elevated-background;
  border: 1px solid @tb-strong-border;
  color: @tb-text;
  padding: 3px 5px;
}

QScrollBar:vertical {
  background: @tb-panel-background;
  border: none;
  margin: 0;
  width: 10px;
}

QScrollBar:horizontal {
  background: @tb-panel-background;
  border: none;
  height: 10px;
  margin: 0;
}

QScrollBar::handle {
  background: @tb-strong-border;
  border-radius: 3px;
  min-height: 24px;
  min-width: 24px;
}

QScrollBar::handle:hover {
  background: @tb-secondary-text;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
  background: transparent;
  border: none;
  height: 0;
  width: 0;
}

QSplitter::handle {
  background: @tb-border;
}

QListWidget#controlListBox_listWidget {
  border: none;
}

QCheckBox#entityDefinition_checkboxWidget {
  margin-left: 11px;
}

QToolButton#toolButton_withBorder {
  background: transparent;
  border: 1px solid @tb-border;
  border-radius: 3px;
}

QToolButton#toolButton_withBorder:hover {
  background: @tb-hover-background;
}

QToolButton#toolButton_withBorder:checked {
  background: @tb-pressed-background;
}

tb--ui--BitmapButton {
  border: none;
}

tb--ui--BitmapButton::menu-indicator {
  image: none;
}

QScrollArea#outlinerPropertyScrollArea {
  background: transparent;
}

QWidget#outlinerPropertyList {
  background: @tb-editor-background;
}

QLabel#outlinerPropertySelectionSummary {
  background: @tb-editor-background;
  border-bottom: 1px solid @tb-border;
  color: @tb-text;
  padding: 4px 8px;
}

QWidget#outlinerPropertyAddBar {
  background: @tb-editor-background;
  border-top: 1px solid @tb-border;
}

QWidget#outlinerPropertyRow {
  background: transparent;
  border-bottom: 1px solid @tb-border;
}

QWidget#outlinerPropertyRow:hover {
  background: @tb-hover-background;
}

QWidget#outlinerPropertyRow[inactive="true"] {
  background: transparent;
}

QWidget#outlinerPropertyKey QLabel {
  color: @tb-text;
}

QWidget#outlinerPropertyKey[inactive="true"] QLabel {
  color: @tb-secondary-text;
}

QLineEdit#outlinerPropertyValue,
QComboBox#outlinerPropertyValue,
QLineEdit#outlinerPropertyAddKey,
QLineEdit#outlinerPropertyAddValue {
  background: @tb-input-background;
  border: 1px solid @tb-border;
  border-radius: 3px;
  padding: 2px 5px;
}

QLineEdit#outlinerPropertyValue:focus,
QComboBox#outlinerPropertyValue:focus,
QLineEdit#outlinerPropertyAddKey:focus,
QLineEdit#outlinerPropertyAddValue:focus {
  background: @tb-input-background;
  border-color: @tb-focus-border;
}

QWidget#outlinerPropertyRow[inactive="true"] QLineEdit#outlinerPropertyValue,
QWidget#outlinerPropertyRow[inactive="true"] QComboBox#outlinerPropertyValue {
  background: @tb-window-background;
  border-color: @tb-border;
}

QWidget#outlinerPropertyActions QToolButton#toolButton_withBorder,
QWidget#outlinerPropertyAddBar QToolButton#toolButton_withBorder {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
}

QWidget#outlinerPropertyActions QToolButton#toolButton_withBorder:hover,
QWidget#outlinerPropertyAddBar QToolButton#toolButton_withBorder:hover {
  background: @tb-hover-background;
  border-color: @tb-border;
}

QWidget#outlinerPropertyActions QToolButton#toolButton_withBorder:pressed,
QWidget#outlinerPropertyActions QToolButton#toolButton_withBorder:checked,
QWidget#outlinerPropertyAddBar QToolButton#toolButton_withBorder:pressed {
  background: @tb-pressed-background;
}

QToolButton#outlinerPropertyColorButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
}

QToolButton#outlinerPropertyColorButton:hover {
  background: @tb-hover-background;
  border-color: @tb-border;
}

QToolButton#outlinerPropertyColorButton:pressed {
  background: @tb-pressed-background;
}

QWidget#smartSkyboxHeader {
  background: transparent;
}

QLabel#smartSkyboxTitle {
  color: @tb-text;
  font-weight: bold;
}

QToolButton#smartSkyboxRefreshButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
}

QToolButton#smartSkyboxRefreshButton:hover {
  background: @tb-hover-background;
  border-color: @tb-border;
}

QListWidget#smartSkyboxList {
  background: transparent;
  outline: none;
}
