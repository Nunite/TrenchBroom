uniform sampler2D Material;
uniform vec3 CameraPosition;
uniform int SkyFaceIndex;
uniform vec4 TintColor;

varying float selected;

const float SkyUvMin = 1.0 / 512.0;
const float SkyUvMax = 1.0 - SkyUvMin;

float insetSkyUv(float value)
{
  return SkyUvMin + (SkyUvMax - SkyUvMin) * value;
}

bool faceMatchesDirection(vec3 dir, int face)
{
  vec3 absDir = abs(dir);
  if (absDir.y >= absDir.x && absDir.y >= absDir.z)
  {
    return dir.y < 0.0 ? face == 3 : face == 1;
  }
  if (absDir.x >= absDir.y && absDir.x >= absDir.z)
  {
    return dir.x > 0.0 ? face == 0 : face == 2;
  }
  return dir.z > 0.0 ? face == 4 : face == 5;
}

vec2 skyUv(vec3 dir, int face)
{
  vec2 uv = vec2(0.0, 0.0);

  if (face == 0)
  {
    uv = vec2(128.0 - (dir.y / dir.x) * 128.0, 128.0 - (dir.z / dir.x) * 128.0) / 256.0;
  }
  else if (face == 1)
  {
    uv = vec2((dir.x / dir.y) * 128.0 + 128.0, 128.0 - (dir.z / dir.y) * 128.0) / 256.0;
  }
  else if (face == 2)
  {
    uv = vec2((dir.y / -dir.x) * 128.0 + 128.0, 128.0 - (dir.z / -dir.x) * 128.0) / 256.0;
  }
  else if (face == 3)
  {
    uv = vec2(128.0 - (dir.x / -dir.y) * 128.0, 128.0 - (dir.z / -dir.y) * 128.0) / 256.0;
  }
  else if (face == 4)
  {
    uv = vec2(128.0 - (dir.x / dir.z) * 128.0, (dir.y / dir.z) * 128.0 + 128.0) / 256.0;
    uv.x = 1.0 - uv.x;
    uv = vec2(1.0 - uv.y, uv.x);
  }
  else
  {
    uv = vec2(128.0 - (dir.x / -dir.z) * 128.0, (dir.y / -dir.z) * 128.0 + 128.0) / 256.0;
    uv = vec2(1.0 - uv.y, uv.x);
  }

  return vec2(insetSkyUv(uv.x), insetSkyUv(uv.y));
}

void main(void)
{
  vec3 worldPosition = gl_TexCoord[1].xyz;
  vec3 dir = normalize(worldPosition - CameraPosition);
  if (!faceMatchesDirection(dir, SkyFaceIndex))
  {
    discard;
  }

  gl_FragColor = texture2D(Material, skyUv(dir, SkyFaceIndex));
  if (selected > 0.5)
  {
    gl_FragColor =
      vec4(gl_FragColor.rgb * TintColor.rgb * TintColor.a, gl_FragColor.a);
    float brightnessCorrection =
      1.0 / max(max(abs(TintColor.r), abs(TintColor.g)), abs(TintColor.b));
    gl_FragColor = clamp(brightnessCorrection * gl_FragColor, 0.0, 1.0);
  }
}
